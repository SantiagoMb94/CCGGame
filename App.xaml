<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CCGGame"
             xmlns:conv="clr-namespace:CCGGame.Converters"
             x:Class="CCGGame.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/CardStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters globales -->
            <conv:TypeToIconConverter x:Key="TypeToIconConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
