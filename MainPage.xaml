<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CCGGame.ViewModels"
             x:Class="CCGGame.MainPage"
             x:DataType="viewmodels:MainMenuViewModel"
             Title="Menú Principal">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource Primary}"
                Padding="20,40,20,20">
            <VerticalStackLayout Spacing="10">
                <Label Text="⚔️ CCG GAME" 
                       FontSize="36" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <Label Text="Juego de Cartas Coleccionables" 
                       FontSize="16" 
                       TextColor="White"
                       Opacity="0.9"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="20">
                <Frame HasShadow="True" 
                       CornerRadius="15" 
                       Padding="0"
                       Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="15" Padding="20">
                        <Label Text="Construir Mazo" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Crea y personaliza tu mazo de cartas" 
                               FontSize="14"
                               Opacity="0.7"
                               HorizontalOptions="Center" />
                        <Button Text="Construir Mazo" 
                                Command="{Binding NavigateToDeckBuilderCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontSize="16"
                                HeightRequest="50"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Frame>

                <Frame HasShadow="True" 
                       CornerRadius="15" 
                       Padding="0">
                    <VerticalStackLayout Spacing="15" Padding="20">
                        <Label Text="Duelo" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Comienza un duelo contra un oponente" 
                               FontSize="14"
                               Opacity="0.7"
                               HorizontalOptions="Center" />
                        <Button Text="Iniciar Duelo" 
                                Command="{Binding NavigateToDuelCommand}"
                                BackgroundColor="{StaticResource Tertiary}"
                                TextColor="White"
                                FontSize="16"
                                HeightRequest="50"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Frame>

                <Frame HasShadow="True" 
                       CornerRadius="15" 
                       Padding="0">
                    <VerticalStackLayout Spacing="15" Padding="20">
                        <Label Text="📚 Colección" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Explora todas las cartas disponibles" 
                               FontSize="14"
                               Opacity="0.7"
                               HorizontalOptions="Center" />
                        <Button Text="Ver Colección" 
                                Command="{Binding NavigateToDeckBuilderCommand}"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="{StaticResource PrimaryDarkText}"
                                FontSize="16"
                                HeightRequest="50"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <Border Grid.Row="2" 
                BackgroundColor="{StaticResource Gray100}"
                Padding="20,10">
            <Label Text="Versión 1.0" 
                   FontSize="12"
                   Opacity="0.6"
                   HorizontalOptions="Center" />
        </Border>
    </Grid>

</ContentPage>
