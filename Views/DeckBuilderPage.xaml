<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CCGGame.ViewModels"
             xmlns:models="clr-namespace:CCGGame.Models"
             x:Class="CCGGame.Views.DeckBuilderPage"
             x:DataType="viewmodels:DeckBuilderViewModel"
             Title="Constructor de Mazos">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header con información del mazo -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource Primary}"
                Padding="15">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{Binding DeckStatus}" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="{Binding ValidationMessage}" 
                           FontSize="12"
                           TextColor="White"
                           Opacity="0.9" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                    <Button Text="Mazo Inicial" 
                            Command="{Binding CreateStarterDeckCommand}"
                            BackgroundColor="White"
                            TextColor="{StaticResource Primary}"
                            FontSize="12"
                            Padding="10,5" />
                    <Button Text="Limpiar" 
                            Command="{Binding ClearDeckCommand}"
                            BackgroundColor="White"
                            TextColor="{StaticResource Primary}"
                            FontSize="12"
                            Padding="10,5" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" 
                BackgroundColor="{StaticResource Gray100}"
                Padding="15">
            <VerticalStackLayout Spacing="10">
                <SearchBar Text="{Binding SearchText, Mode=TwoWay}"
                           Placeholder="Buscar cartas..."
                           BackgroundColor="White" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Picker Grid.Column="0"
                            Title="Tipo"
                            SelectedItem="{Binding SelectedCardType, Mode=TwoWay}"
                            BackgroundColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>All</x:String>
                                <x:String>Warrior</x:String>
                                <x:String>Mage</x:String>
                                <x:String>Ranger</x:String>
                                <x:String>Beast</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <Picker Grid.Column="1"
                            Title="Rareza"
                            SelectedItem="{Binding SelectedRarity, Mode=TwoWay}"
                            BackgroundColor="White">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>All</x:String>
                                <x:String>Common</x:String>
                                <x:String>Rare</x:String>
                                <x:String>Epic</x:String>
                                <x:String>Legendary</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="15">
            <!-- Cartas disponibles -->
            <VerticalStackLayout Grid.Column="0" Spacing="10">
                <Label Text="Cartas Disponibles" 
                       FontSize="16" 
                       FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding AvailableCards}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Card">
                            <Frame HasShadow="True" 
                                   CornerRadius="10" 
                                   Padding="10"
                                   Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                                        <Label Text="{Binding Name}" 
                                               FontSize="14" 
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding CardType}" 
                                               FontSize="12"
                                               Opacity="0.7" />
                                        <Label Text="{Binding Description}" 
                                               FontSize="11"
                                               Opacity="0.8" />
                                        <Label Text="Ataque: {Binding Attack} | Defensa: {Binding Defense} | Costo: {Binding Cost}" 
                                               FontSize="10" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" 
                                                         HorizontalOptions="End"
                                                         Spacing="5">
                                        <Label Text="{Binding Cost}" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" />
                                        <Label Text="Costo" 
                                               FontSize="10"
                                               HorizontalOptions="Center" />
                                        <Button Text="+" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DeckBuilderViewModel}}, Path=AddCardCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="20" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Mazo actual -->
            <VerticalStackLayout Grid.Column="1" Spacing="10">
                <Label Text="Mi Mazo" 
                       FontSize="16" 
                       FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding DeckCards}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Card">
                            <Frame HasShadow="True" 
                                   CornerRadius="10" 
                                   Padding="10"
                                   Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                                        <Label Text="{Binding Name}" 
                                               FontSize="14" 
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding CardType}" 
                                               FontSize="12"
                                               Opacity="0.7" />
                                        <Label Text="Ataque: {Binding Attack} | Defensa: {Binding Defense}" 
                                               FontSize="11" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="-" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DeckBuilderViewModel}}, Path=RemoveCardCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Red"
                                            TextColor="White"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            CornerRadius="20" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>

        <!-- Footer con botón guardar -->
        <Border Grid.Row="3" 
                BackgroundColor="{StaticResource Gray100}"
                Padding="15">
            <Button Text="Guardar Mazo" 
                    Command="{Binding SaveDeckCommand}"
                    IsEnabled="{Binding IsDeckValid}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="10" />
        </Border>
    </Grid>

</ContentPage>

