<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CCGGame.ViewModels"
             xmlns:models="clr-namespace:CCGGame.Models"
             xmlns:conv="clr-namespace:CCGGame.Converters"
             x:Class="CCGGame.Views.DuelPage"
             x:DataType="viewmodels:DuelViewModel"
             Title="Duelo">

    <ContentPage.Resources>
        <conv:HealthToProgressConverter x:Key="HealthToProgressConverter" />
        <conv:ManaToProgressConverter x:Key="ManaToProgressConverter" />
        <conv:CrystalFillConverter x:Key="CrystalFillConverter" />
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0d0b18" Offset="0" />
            <GradientStop Color="#1a1230" Offset="0.45" />
            <GradientStop Color="#0b0814" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
        <!-- Barra de estado / héroes -->
        <Grid Padding="12,10" ColumnDefinitions="*,Auto,*" BackgroundColor="#120f1c" Opacity="0.95">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Oponente -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Frame WidthRequest="64" HeightRequest="64" CornerRadius="32" BackgroundColor="#262040" BorderColor="#c57bff" HasShadow="True">
                    <Label Text="👑" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding OpponentName}" FontSize="17" FontAttributes="Bold" TextColor="White"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="{Binding OpponentHealth, StringFormat='HP {0}'}" FontSize="12" TextColor="#f5f5f5"/>
                        <ProgressBar Grid.Column="1" Progress="{Binding OpponentHealth, Converter={StaticResource HealthToProgressConverter}, ConverterParameter=30}" HeightRequest="8" ProgressColor="#ff5f5f"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="{Binding OpponentEnergy, StringFormat='Maná {0}/10'}" FontSize="12" TextColor="#b7f0ff"/>
                        <ProgressBar Grid.Column="1" Progress="{Binding OpponentEnergy, Converter={StaticResource ManaToProgressConverter}, ConverterParameter=10}" HeightRequest="6" ProgressColor="#4dd3ff"/>
                    </Grid>
                </VerticalStackLayout>
            </Grid>

            <!-- Centro -->
            <StackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4" VerticalOptions="Center">
                <Label Text="VS" FontSize="20" FontAttributes="Bold" TextColor="Gold" HorizontalOptions="Center"/>
                <Label Text="{Binding WinnerMessage}" FontSize="13" FontAttributes="Bold" TextColor="Lime" HorizontalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                <Label Text="{Binding LastEvent}" FontSize="11" TextColor="#d0d0d0" HorizontalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
            </StackLayout>

            <!-- Jugador -->
            <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                    <Label Text="{Binding ActivePlayerName}" FontSize="17" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="{Binding ActivePlayerHealth, StringFormat='HP {0}'}" FontSize="12" TextColor="#f5f5f5" HorizontalTextAlignment="End"/>
                        <ProgressBar Grid.Column="1" Progress="{Binding ActivePlayerHealth, Converter={StaticResource HealthToProgressConverter}, ConverterParameter=30}" HeightRequest="8" ProgressColor="#ff5f5f"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="{Binding ActivePlayerEnergy, StringFormat='Maná {0}/10'}" FontSize="12" TextColor="#b7f0ff" HorizontalTextAlignment="End"/>
                        <ProgressBar Grid.Column="1" Progress="{Binding ActivePlayerEnergy, Converter={StaticResource ManaToProgressConverter}, ConverterParameter=10}" HeightRequest="6" ProgressColor="#4dd3ff"/>
                    </Grid>
                </VerticalStackLayout>
                <Frame Grid.Column="1" WidthRequest="64" HeightRequest="64" CornerRadius="32" BackgroundColor="#262040" BorderColor="#6de2ff" HasShadow="True">
                    <Label Text="🛡️" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
            </Grid>
        </Grid>

        <!-- Tablero central -->
        <Grid Padding="16" RowSpacing="12" BackgroundColor="#0f0c18">
            <Frame BackgroundColor="#251c34" CornerRadius="32" HasShadow="True" BorderColor="#7d5df0" Padding="14">
                <Grid RowDefinitions="Auto,*,Auto,*,Auto" RowSpacing="10">
                    <!-- Barra maná héroe activo -->
                    <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,*" RowSpacing="4" ColumnSpacing="8">
                        <Label Text="Cristales" TextColor="#b7f0ff" FontAttributes="Bold" FontSize="13"/>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                            <Ellipse Fill="#2d2d3a" WidthRequest="16" HeightRequest="16"/>
                            <Ellipse Grid.Column="1" Fill="{Binding ActivePlayerEnergy, Converter={StaticResource CrystalFillConverter}, ConverterParameter=1}" WidthRequest="16" HeightRequest="16"/>
                            <Ellipse Grid.Column="2" Fill="{Binding ActivePlayerEnergy, Converter={StaticResource CrystalFillConverter}, ConverterParameter=2}" WidthRequest="16" HeightRequest="16"/>
                            <Ellipse Grid.Column="3" Fill="{Binding ActivePlayerEnergy, Converter={StaticResource CrystalFillConverter}, ConverterParameter=3}" WidthRequest="16" HeightRequest="16"/>
                            <Ellipse Grid.Column="4" Fill="{Binding ActivePlayerEnergy, Converter={StaticResource CrystalFillConverter}, ConverterParameter=4}" WidthRequest="16" HeightRequest="16"/>
                            <Ellipse Grid.Column="5" Fill="{Binding ActivePlayerEnergy, Converter={StaticResource CrystalFillConverter}, ConverterParameter=5}" WidthRequest="16" HeightRequest="16"/>
                            <Ellipse Grid.Column="6" Fill="{Binding ActivePlayerEnergy, Converter={StaticResource CrystalFillConverter}, ConverterParameter=6}" WidthRequest="16" HeightRequest="16"/>
                            <Ellipse Grid.Column="7" Fill="{Binding ActivePlayerEnergy, Converter={StaticResource CrystalFillConverter}, ConverterParameter=7}" WidthRequest="16" HeightRequest="16"/>
                            <Ellipse Grid.Column="8" Fill="{Binding ActivePlayerEnergy, Converter={StaticResource CrystalFillConverter}, ConverterParameter=8}" WidthRequest="16" HeightRequest="16"/>
                            <Ellipse Grid.Column="9" Fill="{Binding ActivePlayerEnergy, Converter={StaticResource CrystalFillConverter}, ConverterParameter=9}" WidthRequest="16" HeightRequest="16"/>
                        </Grid>
                    </Grid>

                    <!-- Campo oponente -->
                    <Frame Grid.Row="1" BackgroundColor="#2d263a" CornerRadius="18" BorderColor="#a27bff" Padding="10" HasShadow="True">
                        <CollectionView ItemsSource="{Binding Player2Field}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedTargetCard, Mode=TwoWay}"
                                        ItemsLayout="HorizontalList"
                                        HorizontalScrollBarVisibility="Always"
                                        HeightRequest="190">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <Frame HasShadow="True"
                                           CornerRadius="18"
                                           Padding="8"
                                           Margin="6"
                                           WidthRequest="150"
                                           HeightRequest="190"
                                           BackgroundColor="#1f1a2b"
                                           BorderColor="#a27bff">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DuelViewModel}}, Path=AttackCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>
                                        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                                            <Frame Grid.Row="0" Grid.Column="0" Padding="6" CornerRadius="14" BackgroundColor="#1f8be6" HasShadow="False">
                                                <Label Text="{Binding Cost}" FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                            </Frame>
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding CardType, Converter={StaticResource TypeToIconConverter}}"
                                                   FontSize="18" TextColor="White" HorizontalOptions="End" Padding="4"/>
                                            <Image Grid.Row="1" Grid.ColumnSpan="2"
                                                   Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="80"/>
                                            <Label Grid.Row="2" Grid.ColumnSpan="2"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   TextColor="White" />
                                            <Label Grid.Row="3" Grid.ColumnSpan="2"
                                                   Text="{Binding KeywordsDisplay}"
                                                   FontSize="11"
                                                   TextColor="Aqua"
                                                   HorizontalOptions="Center"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation"/>
                                            <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto">
                                                <Frame Padding="6,2" BackgroundColor="#8b1c1c" CornerRadius="8">
                                                    <Label Text="{Binding Attack}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                                </Frame>
                                                <Frame Grid.Column="2" Padding="6,2" BackgroundColor="#1c3f8b" CornerRadius="8" HorizontalOptions="End">
                                                    <Label Text="{Binding Defense}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                                </Frame>
                                            </Grid>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Frame>

                    <!-- Separador -->
                    <BoxView Grid.Row="2" HeightRequest="4" BackgroundColor="#120f1c" CornerRadius="2" Opacity="0.6"/>

                    <!-- Campo jugador -->
                    <Frame Grid.Row="3" BackgroundColor="#262038" CornerRadius="18" BorderColor="#6de2ff" Padding="10" HasShadow="True">
                        <CollectionView ItemsSource="{Binding Player1Field}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedFieldCard, Mode=TwoWay}"
                                        ItemsLayout="HorizontalList"
                                        HorizontalScrollBarVisibility="Always"
                                        HeightRequest="190">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <Frame HasShadow="True"
                                           CornerRadius="18"
                                           Padding="8"
                                           Margin="6"
                                           WidthRequest="150"
                                           HeightRequest="190"
                                           BackgroundColor="#1c1829"
                                           BorderColor="#6de2ff">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DuelViewModel}}, Path=AttackCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>
                                        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                                            <Frame Grid.Row="0" Grid.Column="0" Padding="6" CornerRadius="14" BackgroundColor="#1f8be6" HasShadow="False">
                                                <Label Text="{Binding Cost}" FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                            </Frame>
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding CardType, Converter={StaticResource TypeToIconConverter}}"
                                                   FontSize="18" TextColor="White" HorizontalOptions="End" Padding="4"/>
                                            <Image Grid.Row="1" Grid.ColumnSpan="2"
                                                   Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="80"/>
                                            <Label Grid.Row="2" Grid.ColumnSpan="2"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   TextColor="White" />
                                            <Label Grid.Row="3" Grid.ColumnSpan="2"
                                                   Text="{Binding KeywordsDisplay}"
                                                   FontSize="11"
                                                   TextColor="Aqua"
                                                   HorizontalOptions="Center"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation"/>
                                            <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto">
                                                <Frame Padding="6,2" BackgroundColor="#8b1c1c" CornerRadius="8">
                                                    <Label Text="{Binding Attack}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                                </Frame>
                                                <Frame Grid.Column="2" Padding="6,2" BackgroundColor="#1c3f8b" CornerRadius="8" HorizontalOptions="End">
                                                    <Label Text="{Binding Defense}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                                </Frame>
                                            </Grid>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Frame>

                    <!-- Espacio inferior (para separar tablero de mano) -->
                    <BoxView Grid.Row="4" HeightRequest="8" BackgroundColor="#120f1c" Opacity="0.0"/>
                </Grid>
            </Frame>
        </Grid>

        <!-- Mano -->
        <Grid Padding="12,6" BackgroundColor="#0f0c18" RowDefinitions="Auto,Auto">
            <Label Text="Tu Mano" FontSize="15" FontAttributes="Bold" TextColor="White" Margin="6,0"/>
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Player1Hand}"
                            ItemsLayout="HorizontalList"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedHandCard, Mode=TwoWay}"
                            HeightRequest="210"
                            Margin="0,4,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Card">
                                <Frame HasShadow="True"
                               CornerRadius="18"
                               Padding="10"
                               Margin="6"
                               WidthRequest="150"
                               HeightRequest="200"
                               BackgroundColor="#1c1829"
                               BorderColor="#6de2ff">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DuelViewModel}}, Path=PlayCardCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnDefinitions="Auto,*">
                                <Frame Grid.Row="0" Grid.Column="0" Padding="6" CornerRadius="14" BackgroundColor="#1f8be6" HasShadow="False">
                                    <Label Text="{Binding Cost}" FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                </Frame>
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding CardType, Converter={StaticResource TypeToIconConverter}}"
                                       FontSize="18" TextColor="White" HorizontalOptions="End" Padding="4"/>
                                <Image Grid.Row="1" Grid.ColumnSpan="2"
                                       Source="{Binding ImageUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="70"/>
                                <Label Grid.Row="2" Grid.ColumnSpan="2"
                                       Text="{Binding Name}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="White" />
                                <Label Grid.Row="3" Grid.ColumnSpan="2"
                                       Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="#dcdcdc"
                                       HorizontalOptions="Center"
                                       LineBreakMode="WordWrap"
                                       MaxLines="3"/>
                                <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto">
                                    <Frame Padding="6,2" BackgroundColor="#8b1c1c" CornerRadius="8">
                                        <Label Text="{Binding Attack}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                    </Frame>
                                    <Frame Grid.Column="2" Padding="6,2" BackgroundColor="#1c3f8b" CornerRadius="8" HorizontalOptions="End">
                                        <Label Text="{Binding Defense}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                    </Frame>
                                </Grid>
                                <Button Grid.Row="5" Grid.ColumnSpan="2"
                                        Text="Jugar"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DuelViewModel}}, Path=PlayCardCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#4b7bff"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        FontSize="12"
                                        Padding="6,4"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Controles inferiores / log -->
        <Grid Grid.Row="1" Padding="14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" BackgroundColor="#0d0b18" Opacity="0.95">
            <Label Text="{Binding GameLog}" TextColor="#d0d0d0" LineBreakMode="TailTruncation" MaxLines="2"/>
            <Button Grid.Column="1"
                    Text="Iniciar juego"
                    Command="{Binding StartGameCommand}"
                    BackgroundColor="#4b7bff"
                    TextColor="White"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    Padding="14,10"/>
            <Button Grid.Column="2"
                    Text="Terminar turno"
                    Command="{Binding EndTurnCommand}"
                    IsEnabled="{Binding IsGameActive}"
                    BackgroundColor="#2e9b4f"
                    TextColor="White"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    Padding="14,10"/>
        </Grid>
    </Grid>

</ContentPage>
