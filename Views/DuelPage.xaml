<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CCGGame.ViewModels"
             xmlns:models="clr-namespace:CCGGame.Models"
             x:Class="CCGGame.Views.DuelPage"
             x:DataType="viewmodels:DuelViewModel"
             Title="Duelo">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <!-- Resultado -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Gray900}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,*" Padding="10">
                <Label Grid.Column="0"
                       Text="{Binding OpponentName}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Grid.Column="2"
                       HorizontalOptions="End"
                       Text="{Binding ActivePlayerName}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Grid.ColumnSpan="3" Grid.Row="1"
                       Text="{Binding WinnerMessage}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="Lime"
                       HorizontalOptions="Center" />
            </Grid>
        </Grid>

        <!-- Información del oponente -->
        <Border Grid.Row="1" 
                BackgroundColor="{StaticResource Tertiary}"
                Padding="15">
            <Grid ColumnDefinitions="*,Auto,*">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{Binding OpponentName}" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="{Binding OpponentHealth, StringFormat='Vida: {0}'}" 
                           FontSize="14"
                           TextColor="White" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="VS" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="2" 
                                     HorizontalOptions="End">
                    <Label Text="{Binding ActivePlayerName}" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="{Binding ActivePlayerHealth, StringFormat='Vida: {0}'}"
                           FontSize="14"
                           TextColor="White" />
                    <Label Text="{Binding ActivePlayerEnergy, StringFormat='Energía: {0}'}"
                           FontSize="14"
                           TextColor="White" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Campo de batalla -->
        <ScrollView Grid.Row="2" Padding="15">
            <VerticalStackLayout Spacing="15">
                <!-- Campo del oponente -->
                <Frame HasShadow="True" 
                       CornerRadius="10" 
                       Padding="10"
                       BackgroundColor="{StaticResource Gray100}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Campo del Oponente" 
                               FontSize="14" 
                               FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding Player2Field}"
                                        ItemsLayout="HorizontalList"
                                        HorizontalScrollBarVisibility="Always">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <Frame HasShadow="True" 
                                           CornerRadius="8" 
                                           Padding="8"
                                           Margin="0,0,8,5"
                                           BackgroundColor="White">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Name}" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding CardType}" FontSize="10" Opacity="0.7" />
                                            <Label Text="⚔️ {Binding Attack}   🛡️ {Binding Defense}" FontSize="10" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Campo del jugador activo -->
                <Frame HasShadow="True" 
                       CornerRadius="10" 
                       Padding="10"
                       BackgroundColor="{StaticResource Secondary}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tu Campo" 
                               FontSize="14" 
                               FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding Player1Field}"
                                        ItemsLayout="HorizontalList"
                                        HorizontalScrollBarVisibility="Always">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <Frame HasShadow="True" 
                                           CornerRadius="8" 
                                           Padding="8"
                                           Margin="0,0,8,5"
                                           BackgroundColor="{StaticResource Gray900}"
                                           BorderColor="{StaticResource Primary}">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                            <VerticalStackLayout Grid.Column="0" Grid.RowSpan="3" Spacing="3">
                                                <Label Text="{Binding Name}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold"
                                                       TextColor="White" />
                                                <Label FontSize="10" Opacity="0.8" TextColor="White">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding CardType, Converter={StaticResource TypeToIconConverter}}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding CardType}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label FontSize="10" TextColor="White">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="⚔️ " />
                                                            <Span Text="{Binding Attack}" />
                                                            <Span Text="   🛡️ " />
                                                            <Span Text="{Binding Defense}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="White">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="💧 " />
                                                            <Span Text="{Binding Cost}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1"
                                                    Text="Atacar" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DuelViewModel}}, Path=AttackCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Red"
                                                    TextColor="White"
                                                    FontSize="10"
                                                    Padding="10,5"
                                                    CornerRadius="5" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Mano del jugador -->
        <Border Grid.Row="3" 
                BackgroundColor="{StaticResource Primary}"
                Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="Tu Mano" 
                       FontSize="14" 
                       FontAttributes="Bold"
                       TextColor="White" />
                <CollectionView ItemsSource="{Binding Player1Hand}"
                                ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Card">
                            <Frame HasShadow="True" 
                                   CornerRadius="10" 
                                   Padding="10"
                                   Margin="5"
                                   WidthRequest="170"
                                   BackgroundColor="{StaticResource Gray900}"
                                   BorderColor="{StaticResource Primary}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding CardType, Converter={StaticResource TypeToIconConverter}}" 
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           TextColor="White" />
                                    <Label Text="{Binding Name}" 
                                           FontSize="13" 
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center" />
                                    <Label FontSize="11"
                                           Opacity="0.8"
                                           TextColor="White"
                                           HorizontalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding CardType, Converter={StaticResource TypeToIconConverter}}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding CardType}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="11"
                                           TextColor="White"
                                           HorizontalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="⚔️ " />
                                                <Span Text="{Binding Attack}" />
                                                <Span Text="   🛡️ " />
                                                <Span Text="{Binding Defense}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="11" 
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="💧 " />
                                                <Span Text="{Binding Cost}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Button Text="Jugar" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DuelViewModel}}, Path=PlayCardCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            FontSize="11"
                                            Padding="8,6"
                                            CornerRadius="6" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Controles y log -->
        <Grid Grid.Row="4" 
              RowDefinitions="Auto,*"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Padding="15">
            <Button Grid.Row="0" 
                    Grid.Column="0"
                    Text="Iniciar Juego" 
                    Command="{Binding StartGameCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10" />
            <Button Grid.Row="0" 
                    Grid.Column="1"
                    Text="Terminar Turno" 
                    Command="{Binding EndTurnCommand}"
                    IsEnabled="{Binding IsGameActive}"
                    BackgroundColor="{StaticResource Tertiary}"
                    TextColor="White"
                    CornerRadius="10" />
            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    BackgroundColor="{StaticResource Gray900}"
                    Padding="10"
                    Margin="0,10,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding LastEvent}"
                           FontAttributes="Bold"
                           FontSize="12"
                           TextColor="White" />
                    <ScrollView HeightRequest="120">
                        <Label Text="{Binding GameLog}" 
                               FontSize="11"
                               LineBreakMode="WordWrap"
                               TextColor="White" />
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>

