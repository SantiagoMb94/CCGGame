<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CCGGame.ViewModels"
             xmlns:models="clr-namespace:CCGGame.Models"
             x:Class="CCGGame.Views.DuelPage"
             x:DataType="viewmodels:DuelViewModel"
             Title="Duelo">

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Información del oponente -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource Tertiary}"
                Padding="15">
            <Grid ColumnDefinitions="*,Auto,*">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{Binding OpponentName}" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Vida: {Binding OpponentHealth}" 
                           FontSize="14"
                           TextColor="White" />
                </VerticalStackLayout>
                <Label Grid.Column="1"
                       Text="VS" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="2" 
                                     HorizontalOptions="End">
                    <Label Text="{Binding ActivePlayerName}" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Vida: {Binding ActivePlayerHealth} | Energía: {Binding ActivePlayerEnergy}" 
                           FontSize="14"
                           TextColor="White" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Campo de batalla -->
        <ScrollView Grid.Row="1" Padding="15">
            <VerticalStackLayout Spacing="15">
                <!-- Campo del oponente -->
                <Frame HasShadow="True" 
                       CornerRadius="10" 
                       Padding="10"
                       BackgroundColor="{StaticResource Gray100}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Campo del Oponente" 
                               FontSize="14" 
                               FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding Player2Field}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <Frame HasShadow="True" 
                                           CornerRadius="8" 
                                           Padding="8"
                                           Margin="0,0,0,5"
                                           BackgroundColor="White">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                <Label Text="{Binding Name}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold" />
                                                <Label Text="Ataque: {Binding Attack} | Defensa: {Binding Defense}" 
                                                       FontSize="10" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Campo del jugador activo -->
                <Frame HasShadow="True" 
                       CornerRadius="10" 
                       Padding="10"
                       BackgroundColor="{StaticResource Secondary}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tu Campo" 
                               FontSize="14" 
                               FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding Player1Field}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <Frame HasShadow="True" 
                                           CornerRadius="8" 
                                           Padding="8"
                                           Margin="0,0,0,5"
                                           BackgroundColor="White">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                <Label Text="{Binding Name}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold" />
                                                <Label Text="Ataque: {Binding Attack} | Defensa: {Binding Defense}" 
                                                       FontSize="10" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1"
                                                    Text="Atacar" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DuelViewModel}}, Path=AttackCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Red"
                                                    TextColor="White"
                                                    FontSize="10"
                                                    Padding="10,5"
                                                    CornerRadius="5" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Mano del jugador -->
        <Border Grid.Row="2" 
                BackgroundColor="{StaticResource Primary}"
                Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="Tu Mano" 
                       FontSize="14" 
                       FontAttributes="Bold"
                       TextColor="White" />
                <CollectionView ItemsSource="{Binding Player1Hand}" 
                                Orientation="Horizontal">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Card">
                            <Frame HasShadow="True" 
                                   CornerRadius="8" 
                                   Padding="10"
                                   Margin="5"
                                   WidthRequest="150"
                                   BackgroundColor="White">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding Name}" 
                                           FontSize="12" 
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding CardType}" 
                                           FontSize="10"
                                           Opacity="0.7" />
                                    <Label Text="Ataque: {Binding Attack} | Defensa: {Binding Defense}" 
                                           FontSize="9" />
                                    <Label Text="Costo: {Binding Cost}" 
                                           FontSize="10" 
                                           FontAttributes="Bold" />
                                    <Button Text="Jugar" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DuelViewModel}}, Path=PlayCardCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="White"
                                            FontSize="10"
                                            Padding="5"
                                            CornerRadius="5" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Controles y log -->
        <Grid Grid.Row="3" 
              RowDefinitions="Auto,*"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Padding="15">
            <Button Grid.Row="0" 
                    Grid.Column="0"
                    Text="Iniciar Juego" 
                    Command="{Binding StartGameCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="10" />
            <Button Grid.Row="0" 
                    Grid.Column="1"
                    Text="Terminar Turno" 
                    Command="{Binding EndTurnCommand}"
                    IsEnabled="{Binding IsGameActive}"
                    BackgroundColor="{StaticResource Tertiary}"
                    TextColor="White"
                    CornerRadius="10" />
            <ScrollView Grid.Row="1" 
                        Grid.ColumnSpan="2"
                        HeightRequest="100"
                        Margin="0,10,0,0">
                <Label Text="{Binding GameLog}" 
                       FontSize="11"
                       LineBreakMode="WordWrap" />
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>

